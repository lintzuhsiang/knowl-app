# =============================================================================
# knowl-app — environment template
# =============================================================================
# Copy this to `.env` for local dev (server reads it via the shell).
# For production, set these via your deploy target's secret manager — DO NOT
# commit a real .env to git.
#
# Frontend (VITE_*) values are baked into the JS bundle at build time.
# Server values are read at runtime by Node.

# ─── LLM ────────────────────────────────────────────────────────────────────
# REQUIRED. Server-side Gemini key. The frontend never sees this.
GEMINI_API_KEY=
# Model override. Defaults to gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-pro
# Reserved for future provider swap (anthropic/openai). Currently 'gemini'.
LLM_PROVIDER=gemini

# ─── Auth / security ────────────────────────────────────────────────────────
# Legacy shared-secret token mode. If set, clients sending this exact token in
# x-auth-token get admin access as the default user (skips DB session lookup).
# Leave unset for normal production (forces DB-session auth).
AUTH_SECRET=

# Comma-separated allowed origins for CORS in production.
# Use '*' for dev only. Example: https://app.knowl.com,https://www.knowl.com
CORS_ORIGIN=*

# Set to '1' (or higher hop count) when behind ALB / nginx / Cloudflare so
# req.ip reflects the real client IP. Required for accurate rate limiting.
TRUST_PROXY=

# ─── Storage ────────────────────────────────────────────────────────────────
# SQLite file location. In Docker this is /data/knowl.db on a mounted volume.
DB_PATH=./knowl.db

# ─── HTTP ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── LLM cost guard ─────────────────────────────────────────────────────────
# Per-user 24h token budget. 0 disables enforcement. ~200K ≈ $0.65/day at
# Gemini 2.5 Pro pricing.
LLM_DAILY_TOKEN_BUDGET=200000

# ─── Backup / cleanup cron ──────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
TRACE_RETENTION_DAYS=90
# Set to '1' to skip starting cron (useful in tests / dev). Leave unset in prod.
DISABLE_JOBS=

# Optional S3 backup upload. Set the bucket and the daily backup will also
# upload there. Requires `npm i @aws-sdk/client-s3` and AWS credentials in
# the environment OR an IAM role attached to the EC2/ECS instance.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=backups/
AWS_REGION=us-east-1

# ─── Error tracking — Sentry (backend) ──────────────────────────────────────
# Leave blank to disable. Get a DSN from sentry.io after creating a project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0.0–1.0 — fraction of requests traced. 0.1 (10%) is a sensible default.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set by CI to the deploying commit SHA — helps Sentry tie errors to releases.
SENTRY_RELEASE=

# ─── Email (verification + password reset) ──────────────────────────────────
# Provider dispatch. Default 'console' = log emails to stdout, never sends —
# auth flows still work, you copy the verify/reset link from logs in dev.
# Options: console (default), resend, sendgrid, ses
MAIL_PROVIDER=console

# Per-provider credentials — only the one matching MAIL_PROVIDER is read.
RESEND_API_KEY=
SENDGRID_API_KEY=
# (SES uses AWS credentials from env / IAM role; no key here)

# From-address on outgoing emails. Must be a verified sender at your provider.
MAIL_FROM=noreply@knowl.example.com

# Used to build verify/reset URLs in email templates. Set to the public SPA
# origin in production (e.g. https://app.knowl.com). Defaults to localhost.
APP_BASE_URL=http://localhost:3000

# ─── Frontend (VITE_*) — baked into the SPA bundle at build time ────────────
# Absolute API URL when the SPA and API live on different origins (e.g. iOS
# Capacitor build, or SPA on S3+CloudFront with API on EC2). Empty = same
# origin via relative paths.
VITE_API_BASE=

# Frontend Sentry DSN (separate project from backend, or same — your call).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=
